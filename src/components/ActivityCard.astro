---
import {BrandArrayColors, BGArrayColors, BorderArrayColors, HoverShadowArrayColors} from '../Utils/Constants.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  date: string;
  index: number;
}

const { id, title, description, date, index} = Astro.props;
---

<a
  href={`/activity/${id}`}
  class:list={["group block w-full max-w-sm rounded-xl border bg-white p-6 shadow-sm transition", BorderArrayColors[index], HoverShadowArrayColors[index]]}
>
  <h2 class:list={["text-xl font-semibold group-hover:text-white-700", BrandArrayColors[index]]}>
    {title}
  </h2>

  {
    description && (
      <p class="mt-2 line-clamp-3 text-sm text-white-600">{description}</p>
    )
  }

  {
    date && (
      <time datetime={date} class="mt-4 block text-xs">
        {new Date(date).toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </time>
    )
  }
</a>
