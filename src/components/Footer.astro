---
import SocialLinks from './Social.astro';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/activities', label: 'Actividades' },
  { href: '/about', label: 'Sobre mí' },
  { href: '/blog', label: 'Blog' },
];

const legalLinks = [
  { href: '/privacidad', label: 'Política de privacidad' },
  { href: '/cookies', label: 'Política de cookies' },
];
---

<footer class="relative mt-auto shrink-0 border-t border-sky-200/80 bg-gradient-to-b from-sky-50 to-sky-100/90">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-sky-400 via-sky-500 to-indigo-400"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5 pb-8 pt-12 sm:pb-10">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-3 transition opacity-90 hover:opacity-100">
          <img src="/logo.png" alt="BEVE" class="h-10 w-auto" />
          <span class="text-lg font-semibold tracking-tight text-slate-800">BEVE</span>
        </a>
        <p class="max-w-xs text-sm leading-relaxed text-slate-600">
          Formación, educación y proyectos técnicos con impacto en el aula y en la industria.
        </p>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Navegación</h2>
        <ul class="mt-4 space-y-2.5">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-700 transition hover:text-sky-700 hover:underline underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Contacto</h2>
        <p class="mt-4 text-sm text-slate-600">¿Hablamos? Encuéntranos en:</p>
        <div class="mt-4">
          <SocialLinks
            linkedin="https://www.linkedin.com/in/tu-usuario"
            email="hola@tudominio.com"
          />
        </div>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-sky-200/70 pt-6 sm:flex-row"
    >
      <p class="text-xs text-slate-500">© {currentYear} BEVE. Todos los derechos reservados.</p>

      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Enlaces legales">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-xs text-slate-500 transition hover:text-sky-700 hover:underline underline-offset-4"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
