---
const apiUrl = import.meta.env.NEW_MEMBER_API_URL;

if (!apiUrl) {
  console.warn('NEW_MEMBER_API_URL no está configurada.');
}
---

<form id="myForm" class="space-y-6 px-6 pb-8 sm:px-10 sm:pb-10" novalidate>
  <div class="grid gap-6 sm:grid-cols-2">

    <!-- Nombre: línea completa -->
    <div class="sm:col-span-2">
      <label for="nombre" class="mb-2 block text-sm font-semibold text-slate-700">
        Nombre
      </label>
      <input type="text" id="nombre" name="nombre" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <!-- Apellidos: mitad y mitad -->
    <div>
      <label for="apellido1" class="mb-2 block text-sm font-semibold text-slate-700">
        Primer apellido
      </label>
      <input type="text" id="apellido1" name="apellido1" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <div>
      <label for="apellido2" class="mb-2 block text-sm font-semibold text-slate-700">
        Segundo apellido
      </label>
      <input type="text" id="apellido2" name="apellido2" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <!-- Teléfono: línea completa -->
    <div class="sm:col-span-2">
      <label for="telefono" class="mb-2 block text-sm font-semibold text-slate-700">
        Teléfono
      </label>
      <input type="tel" id="telefono" name="telefono" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

  </div>

  <div>
    <label id="emailLabel" for="email" class="mb-2 block text-sm font-semibold text-slate-700">
      Correo electrónico
    </label>
    <input type="email" id="email" name="email" required
      class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
  </div>

  <div>
    <label for="direccion" class="mb-2 block text-sm font-semibold text-slate-700">
      Dirección
    </label>
    <input type="text" id="direccion" name="direccion" required
      class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="pais" class="mb-2 block text-sm font-semibold text-slate-700">
        País
      </label>
      <input type="text" id="pais" name="pais" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <div>
      <label for="ciudad" class="mb-2 block text-sm font-semibold text-slate-700">
        Ciudad
      </label>
      <input type="text" id="ciudad" name="ciudad" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>
  </div>

  <div>
    <label for="fecha_nacimiento" class="mb-2 block text-sm font-semibold text-slate-700">
      Fecha de nacimiento
    </label>
    <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" required
      class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="formacion_academica" class="mb-2 block text-sm font-semibold text-slate-700">
        Formación académica
      </label>
      <input type="text" id="formacion_academica" name="formacion_academica" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <div>
      <label for="centro_academico" class="mb-2 block text-sm font-semibold text-slate-700">
        Centro académico / Universidad
      </label>
      <input type="text" id="centro_academico" name="centro_academico" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="puesto_trabajo" class="mb-2 block text-sm font-semibold text-slate-700">
        Puesto de trabajo
      </label>
      <input type="text" id="puesto_trabajo" name="puesto_trabajo" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>

    <div>
      <label for="empresa" class="mb-2 block text-sm font-semibold text-slate-700">
        Empresa
      </label>
      <input type="text" id="empresa" name="empresa" required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
    </div>
  </div>

  <div>
    <label id="interesesLabel" for="intereses" class="mb-2 block text-sm font-semibold text-slate-700">
      Intereses <span class="font-normal text-slate-400">· máximo 5, separados por comas</span>
    </label>
    <input type="text" id="intereses" name="intereses" required
      placeholder="Ej. innovación, tecnología, networking"
      class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10" />
  </div>

  <div id="rgpdWrapper" class="rounded-xl border border-slate-200 bg-slate-50 p-4">
    <label class="flex cursor-pointer items-start gap-3">
      <input type="checkbox" id="rgpd" name="rgpd"
        class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
      <span class="text-sm leading-6 text-slate-600">
        Acepto la
        <a href="/rgpd" target="_blank" rel="noopener noreferrer"
          class="font-semibold text-blue-600 underline underline-offset-2 hover:text-blue-700">
          política de privacidad
        </a>
      </span>
    </label>
  </div>

  <div id="mensaje-exito" class="hidden rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-medium text-green-800">
    ¡Enhorabuena! Ya formas parte de la comunidad de profesionales beVE.
  </div>

  <div id="mensaje-error" class="hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-medium text-red-800">
    Error al enviar el formulario. Por favor, inténtalo de nuevo más tarde.
  </div>

  <button id="submitButton" type="submit"
    class="w-full rounded-lg bg-blue-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/20 disabled:cursor-not-allowed disabled:opacity-60">
    Enviar
  </button>
</form>

<script define:vars={{ apiUrl }}>
  const form = document.getElementById("myForm");
  const submitButton = document.getElementById("submitButton");
  const emailInput = document.getElementById("email");
  const emailLabel = document.getElementById("emailLabel");
  const interesesInput = document.getElementById("intereses");
  const interesesLabel = document.getElementById("interesesLabel");
  const checkbox = document.getElementById("rgpd");
  const rgpdWrapper = document.getElementById("rgpdWrapper");
  const successMessage = document.getElementById("mensaje-exito");
  const errorMessage = document.getElementById("mensaje-error");

  const value = (id) => document.getElementById(id).value;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();

    successMessage.classList.add("hidden");
    errorMessage.classList.add("hidden");

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (!emailInput.checkValidity()) {
      emailLabel.classList.add("text-red-600");
      emailInput.classList.add("border-red-500");
      emailInput.focus();
      return;
    }

    emailLabel.classList.remove("text-red-600");
    emailInput.classList.remove("border-red-500");

    if (!checkbox.checked) {
      rgpdWrapper.classList.add("border-red-300", "bg-red-50");
      checkbox.focus();
      return;
    }

    rgpdWrapper.classList.remove("border-red-300", "bg-red-50");

    const intereses = interesesInput.value
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean);

    if (intereses.length > 5) {
      interesesLabel.classList.add("text-red-600");
      interesesInput.classList.add("border-red-500");
      interesesInput.focus();
      return;
    }

    interesesLabel.classList.remove("text-red-600");
    interesesInput.classList.remove("border-red-500");

    if (!apiUrl) {
      errorMessage.textContent = "El endpoint del formulario no está configurado.";
      errorMessage.classList.remove("hidden");
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Enviando...";

    const data = {
      nombre: value("nombre"),
      apellido1: value("apellido1"),
      apellido2: value("apellido2"),
      telefono: value("telefono"),
      email: value("email"),
      pais: value("pais"),
      ciudad: value("ciudad"),
      direccion: value("direccion"),
      fecha_nacimiento: value("fecha_nacimiento"),
      empresa: value("empresa"),
      puesto_trabajo: value("puesto_trabajo"),
      formacion_academica: value("formacion_academica"),
      centro_academico: value("centro_academico"),
      intereses: interesesInput.value,
      rgpd: checkbox.checked,
    };

    try {
      const response = await fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      successMessage.classList.remove("hidden");
      form.reset();
    } catch (error) {
      console.error(error);
      errorMessage.classList.remove("hidden");
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Enviar";
    }
  });

  checkbox.addEventListener("change", () => {
    if (checkbox.checked) {
      rgpdWrapper.classList.remove("border-red-300", "bg-red-50");
    }
  });
</script>
