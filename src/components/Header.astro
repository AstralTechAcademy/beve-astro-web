---
// https://icon-sets.iconify.design/
import { Icon } from 'astro-icon/components';
---
<header>
<nav class="relative mt-5 ml-5 mr-10 z-50">
    <div class="flex flex-row justify-between w-full nav-links">
        <a href="/" class="w-30">
            <img src="/logo.png">
            </img>
        </a>

        <!-- Menu escritorio -->
        <div class="hidden md:flex gap-x-6">
            <a class="text-azul-medio font-semibold relative inline-block transform transition-transform duration-200 hover:-translate-y-[5px]
            after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
            after:bg-current after:transition-all after:duration-1000
            hover:after:w-full" 
                href="/">Inicio</a>
            <a class="text-verde font-semibold relative transform transition-transform duration-200 hover:-translate-y-[5px]
            after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
            after:bg-current after:transition-all after:duration-1000
            hover:after:w-full"
                href="/activities">Actividades</a>
            <a class="text-naranja font-semibold relative transform transition-transform duration-200 hover:-translate-y-[5px]
            after:absolute after:left-0 after:bottom-0 after:h-[2px] after:w-0
            after:bg-current after:transition-all after:duration-1000
            hover:after:w-full"
                href="/quienes-somos">Quiénes somos</a>
        </div>
        <button id="menu-button"
            type="button"
            class="md:hidden p-2"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu">
            <!-- Icono hamburguesa -->
            <Icon class="text-rosa" name="hugeicons:menu-03"></Icon>
        </button>

        <!-- Menu movil -->
        <div id="mobile-menu"
            class="hidden md:hidden absolute left-0 right-0 top-full bg-white shadow-lg"
        >
            <div class="flex flex-col p-4 gap-4">
                <a class="text-azul-medio" href="/">Inicio</a>
                <a class="text-verde" href="/activities">Actividades</a>
                <a class="text-naranja" href="/quienes-somos">Quiénes somos</a>
            </div>
        </div>
    </div>
</nav>
</header>

<script>
  const button = document.querySelector('#menu-button');
  const menu = document.querySelector('#mobile-menu');

  button?.addEventListener('click', () => {
    console.log("hhh")
    menu?.classList.toggle('hidden');

    const isOpen = !menu?.classList.contains('hidden');
    button?.setAttribute('aria-expanded', String(isOpen));
  });
</script>