---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  icon: string
  description?: string;
  accent?: 'orange' | 'pink' | 'blue' | 'green';
}

const { title, description, accent = 'orange' , icon='hugeicons:file-unknown'} = Astro.props;

const accentStyles = {
  orange: {
    border: 'border-orange-500/80',
    bg: 'from-orange-50 via-white to-orange-100/40',
    iconColor: 'text-orange-500',
    title: 'text-orange-500',
    bar: 'bg-orange-400',
  },
  pink: {
    border: 'border-pink-500/80',
    bg: 'from-pink-50 via-white to-pink-100/40',
    iconColor: 'text-pink-500',
    title: 'text-pink-500',
    bar: 'bg-pink-400',
  },
  blue: {
    border: 'border-blue-500/80',
    bg: 'from-blue-50 via-white to-blue-100/40',
    iconColor: 'text-blue-500',
    title: 'text-blue-500',
    bar: 'bg-blue-400',
  },
  green: {
    border: 'border-green-500/80',
    bg: 'from-green-50 via-white to-green-100/40',
    iconColor: 'text-green-500',
    title: 'text-green-500',
    bar: 'bg-green-400',
  },
};

const styles = accentStyles[accent];
---

<div
  class:list={[
    'group relative flex min-h-52 w-full min-w-64 max-w-xs flex-col \
    justify-center items-center overflow-hidden rounded-2xl border \
    px-8 py-10 text-center shadow-md ring-1 ring-transparent transition \
    duration-300 hover:-translate-y-1.5 hover:shadow-xl',
    styles.border,
    `bg-gradient-to-br ${styles.bg}`,
  ]}
>
    
  <Icon  class:list={['text-6xl', styles.iconColor]} name={icon} />
  <h2
    class:list={[
      'text-2xl font-semibold tracking-tight transition-colors',
      styles.title,
    ]}
  >
    {title}
  </h2>

  {
    description && (
      <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>
    )
  }
</div>
