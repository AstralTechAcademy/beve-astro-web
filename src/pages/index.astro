---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
const buttonStyle = "text-black bg-blue-400 hover:bg-blue-500 focus:ring-4 focus:outline-none focus:ring-blue-300 font-normal rounded-lg text-m w-full sm:w-auto px-5 py-2.5 text-center"
---

<Layout>
  	<div class="flex flex-row justify-center gap-5 mt-5">
		<div class="flex items-center justify-center">
			<Card title="Profesionales"></Card>
		</div>
		<div class="flex items-center justify-center">
			<Card title="Educación"></Card>
		</div>
	</div>
	<div class="flex items-center justify-center mt-20">
		<div class="flex flex-col  items-center">
			<h2 class="font-bold">Colaboramos con</h2>
			<img src="../../public/logos_entidades_colaboraciones.png"/>
		</div>
	</div>
</Layout>
