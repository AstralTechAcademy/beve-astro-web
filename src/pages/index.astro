---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout>
  <section class="mx-auto flex max-w-3xl flex-col items-stretch justify-center gap-6 px-5 py-16 sm:flex-row sm:items-center sm:gap-8">
    <Card
      title="Profesionales"
      description="Formación y acompañamiento técnico para equipos y organizaciones."
      accent="sky"
    />
    <Card
      title="Educación"
      description="Actividades y recursos para el aprendizaje en el aula y fuera de ella."
      accent="indigo"
    />
  </section>

  <section class="flex items-center justify-center pb-16 pt-4">
    <div class="flex flex-col items-center gap-4">
      <h2 class="text-lg font-bold text-slate-800">Colaboramos con</h2>
      <img
        src="/logos_entidades_colaboraciones.png"
        alt="Logos de entidades colaboradoras"
        class="max-w-full px-5"
      />
    </div>
  </section>
</Layout>
