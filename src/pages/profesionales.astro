---
import Layout from '../layouts/Layout.astro';
import Card from "../components/Card.astro"
---

<Layout>
<section class="relative flex min-h-[70vh] w-full  items-center justify-center overflow-hidden bg-orange-600 px-6 text-center">
  <div class="relative z-10 max-w-4xl text-white">
    <p class="text-xl font-medium tracking-wide sm:text-2xl">
      Un espacio donde potenciar tus habilidades comunicativas
    </p>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-white/90 sm:text-xl">
      Únete a nuestra comunidad de profesionales
    </p>

    <a
      href="/forms/participar"
      class="mt-8 inline-flex rounded-xl bg-white px-7 py-4
             font-bold text-red-600 shadow-lg
             transition duration-300
             hover:-translate-y-1 hover:bg-gray-100 hover:shadow-xl"
    >
      Quiero participar →
    </a>

    <a
      href="/forms/company"
      class="mt-8 inline-flex rounded-xl bg-white px-7 py-4
             font-bold text-red-600 shadow-lg
             transition duration-300
             hover:-translate-y-1 hover:bg-gray-100 hover:shadow-xl"
    >
      Soy empresa →
    </a>

  </div>
</section>
  <div class="flex flex-col justify-center items-center mt-10 mb-10">
    <h2 class="text-3xl font-bold">Nuestras ventajas</h2>
      <div class="grid grid-cols-2 gap-6 items-center justify-center mt-10">
      <Card
        title="Networking"
        icon="hugeicons:neural-network"
        description="Conoce otros profesionales y haz crecer tu red de Linkedin"
        accent="blue"
      />
      <Card
        title="Oratoria"
        icon="hugeicons:audio-wave-01"
        description="Potencia tus habilidades comunicativas participando en nuestras actividades"
        accent="orange"
      />
      </div>
  </div>
  </div>
</Layout>
