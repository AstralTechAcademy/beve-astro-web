---
import Layout from '../../layouts/Layout.astro';
import ActivityGallery from '../../components/ActivityGallery.astro';
import {BrandArrayColors} from '../../Utils/Constants.astro';
import images from '../../lib/images.json';

export interface GalleryImage {
  url: string;
  alt?: string;
}

type AstroComponentFactory = (props?: Record<string, unknown>) => unknown;

const index=Math.floor(Math.random() * (BrandArrayColors.length - 0 + 1)) + 0;

export async function getStaticPaths() {
  const activityModules = import.meta.glob<{
    frontmatter: Record<string, unknown>;
    Content: AstroComponentFactory;
  }>('../../activities/*.md');

  return Promise.all(
    Object.entries(activityModules).map(async ([path, loader]) => {
      const id = path.match(/\/activities\/(.+)\.md$/)?.[1];
      if (!id) return null;

      const mod = await loader();
      const galleryName : String = mod.frontmatter.gallery as String
      var gallery :string[] = []
      if (Object.keys(images).includes(galleryName))
      {
        gallery = images[galleryName]
      }
      
      return {
        params: { id },
        props: {
          frontmatter: mod.frontmatter,
          Content: mod.Content,
          gallery,
        },
      };
    }),
  ).then((paths) => paths.filter((path) => path !== null));
}

const { frontmatter, Content, gallery } = Astro.props;
---

<Layout>
  <article class="mx-auto max-w-4xl px-5 py-10">
    <a href="/activities" class:list={["text-sm hover:text-sky-800 hover:underline", BrandArrayColors[index]]}>
      ← Volver a actividades
    </a>

    <header class="mt-4 border-b border-sky-100 pb-6">
      <h1 class="text-3xl font-bold text-slate-800">{frontmatter.title}</h1>

      {
        frontmatter.description && (
          <p class="mt-3 text-lg text-slate-600">{frontmatter.description}</p>
        )
      }

      <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
        {
          frontmatter.author && (
            <div>
              <dt class="inline font-medium text-slate-700">Autor: </dt>
              <dd class="inline">{frontmatter.author}</dd>
            </div>
          )
        }
        {
          frontmatter.date && (
            <div>
              <dt class="inline font-medium text-slate-700">Fecha: </dt>
              <dd class="inline">
                <time datetime={String(frontmatter.date)}>
                  {new Date(String(frontmatter.date)).toLocaleDateString('es-ES', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </dd>
            </div>
          )
        }
      </dl>

      {
        Array.isArray(frontmatter.collaborators) && frontmatter.collaborators.length > 0 && (
          <div class="mt-4">
            <h2 class="text-sm font-medium text-slate-700">Colaboradores</h2>
            <ul class="mt-1 flex flex-wrap gap-2">
              {frontmatter.collaborators.map((collaborator: string) => (
                <li class="rounded-full bg-sky-100 px-3 py-1 text-xs text-sky-800">
                  {collaborator}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </header>

    <div class="prose prose-slate mt-8 max-w-none">
      <Content />
    </div>

    <ActivityGallery images={gallery} title={String(frontmatter.title)} />
  </article>
</Layout>

<style>
  .prose :global(h2) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: rgb(30 41 59);
  }

  .prose :global(p) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: rgb(71 85 105);
  }

  .prose :global(ul) {
    margin-top: 0.75rem;
    list-style-type: disc;
    padding-left: 1.25rem;
    color: rgb(71 85 105);
  }
</style>
